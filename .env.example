# .env olarak kopyala ve gerekirse değiştir. .env git'e eklenmez.

# sim = simülasyon (varsayılan). live = canlı mod
MOD=sim
# 1 = gerçek emir gönder (sadece MOD=live ile çalışır). 0 = sadece teklif / simülasyon
CANLI_ISLEM=0

PORT=8787

# Sunucuda zorunlu limitler (BNB). 0 = alım kapalı
ISLEM_BASI_MAX_BNB=0.05
GUNLUK_MAX_BNB=0.2
# Varsayılan kayma (%)
VARSAYILAN_KAYMA=10

# baw komutunun yolu (global kurulumda "baw" yeterli)
BAW_BIN=baw

# Boş bırakılırsa data/api-token içinde otomatik üretilir
API_TOKEN=

# Token basımı (Basım sekmesi, ayrı basıcı cüzdan). Sunucu tavanları (BNB)
BASIM_ONALIM_MAX_BNB=0.02
BASIM_UCRET_MAX_BNB=0.01
# Zincir okuma, simülasyon ve basım işlemi için RPC
BSC_RPC=https://bsc-rpc.publicnode.com
# Yeni blok taraması için RPC havuzu, virgülle; istekler sırayla dağıtılır, hata verende sıradakine geçilir
BSC_BLOK_RPC=https://bsc-dataseed1.defibit.io,https://bsc-dataseed2.defibit.io,https://bsc-dataseed3.defibit.io,https://bsc-dataseed4.defibit.io,https://bsc-dataseed1.ninicoin.io,https://bsc-dataseed2.ninicoin.io,https://bsc-dataseed4.ninicoin.io
# Fabrika içinden kurulan mint kontratlarını bulmak için adres belirtmeden olay sorgusuna izin veren RPC (boş bırakılırsa kapalı)
BSC_OLAY_RPC=https://bsc.drpc.org,https://1rpc.io/bnb

# Mint araştırma ajanları (OpenRouter). Boşsa ajanlar LLM çağırmaz, sadece zincir ve site verisini toplar
OPENROUTER_API_KEY=
# Araştırma ücretsiz modellerle (virgülle yedekli: ilki hız sınırına takılırsa sıradaki). Web araması yine ücretlidir
AJAN_SITE_MODEL=nvidia/nemotron-3.5-super-vl:free,dots-studio/dots-3-note-preview:free,openrouter/free
AJAN_SOSYAL_MODEL=nvidia/nemotron-3.5-super-vl:free,dots-studio/dots-3-note-preview:free,openrouter/free
# Hakem iki raporu okuyup son risk değerlendirmesini yapar: küçük girdi, ucuz ama akıllı model
AJAN_HAKEM_MODEL=anthropic/claude-haiku-5.5
# Ücretsiz web araması: Brave Search API (her ay 5 $ ücretsiz kredi, yaklaşık 1.000 arama). Boşsa arama OpenRouter üzerinden ücretli yapılır
BRAVE_API_KEY=
# Günlük en fazla araştırma (her araştırma 2 LLM çağrısı + web araması)
AJAN_GUNLUK_ARASTIRMA=40
